# =============================================================================
# NYAI Backend — Environment Template
# Copy to backend/.env and replace all REPLACE_* / your-* placeholders.
# For Render: paste KEY=VALUE pairs into Dashboard → Environment.
# =============================================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Render build: MUST be 3.11.x (not 3.14). Also set runtime.txt to python-3.11.9
PYTHON_VERSION=3.11.9

# --- Production hardening (REQUIRED on live) ---
NYAI_API_KEY=your-secret-api-key-here
# If missing: CRITICAL log + all /nyaya/* return 503 AUTH_CONFIGURATION_ERROR
FRONTEND_URL=https://your-frontend.vercel.app
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
# Set true only for local development (exposes /debug/* without auth)
ENABLE_DEBUG_ROUTES=false

# --- Groq LLM (strongly recommended on live) ---
GROQ_ENABLED=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=20
GROQ_DEBUG=false
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_QUERY_UNDERSTANDING_MODEL=llama-3.1-8b-instant
GROQ_QUERY_EXPANDER_MODEL=llama-3.1-8b-instant
GROQ_EXPLAINER_MODEL=llama-3.1-8b-instant
GROQ_QUERY_UNDERSTANDING_ENABLED=true
GROQ_SECTION_RERANK_ENABLED=true
GROQ_SECTION_RERANK_CANDIDATES=18

# --- Provenance / signing ---
HMAC_SECRET_KEY=change-me-in-production
SIGNING_METHOD=HMAC_SHA256
SIGNING_KEY_ID=primary-key-2026
PROVENANCE_LEDGER_PATH=provenance_ledger.json
ENFORCEMENT_LEDGER_PATH=enforcement_ledger.json

# --- Retrieval pipeline ---
HYBRID_RETRIEVER_ENABLED=true
HYBRID_RETRIEVER_TIMEOUT_SECONDS=12
RERANKER_ENABLED=true
RERANKER_TIMEOUT_SECONDS=8
SEMANTIC_SEARCH_ENABLED=false
DETERMINISM_GUARD_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=nyaya.log

# --- Legacy / optional ---
DATABASE_URL=sqlite:///./nyaya.db
INPUT_DIRECTORY=db
# Evidence JSONL directory (nyai_output_log.jsonl). Unset = backend/output_logs locally.
# Render persistent disk: OUTPUT_DIRECTORY=/var/data
OUTPUT_DIRECTORY=output
NONCE_TTL_SECONDS=300
# Co-located on Render disk when OUTPUT_DIRECTORY=/var/data:
# PROVENANCE_LEDGER_PATH=/var/data/provenance_ledger.json

# --- Local development ---
# FRONTEND_URL=http://localhost:5173

# --- Phase VI: BHIV ecosystem integrations ---
# Local/dev: keep flags false. Production (approvals received): set true in Render only.
# See review_packet/enablement_checklist.md for step-by-step enablement.

# Bucket (Siddhesh — approved)
BUCKET_ENDPOINT=https://bhiv-bucket-i1l6.onrender.com
BUCKET_PRODUCER_ENABLED=false

# BHIV Core (Raj — approved, registry-only)
BHIV_CORE_ENDPOINT=http://localhost:8003
BHIV_CORE_ENABLED=false

# InsightFlow (Vijay — endpoint confirmed; key from secrets manager only)
INSIGHTFLOW_ENDPOINT=https://bhiv-mdu-api.onrender.com
INSIGHTFLOW_API_KEY=REPLACE_WITH_ROTATED_KEY
INSIGHTFLOW_ENABLED=false

# CLO (Ansh — served directly by deployed SHAKTI; no CLO_API_KEY on current deployment)
CLO_ENDPOINT=https://shakti-gc-infra.onrender.com
CLO_ENABLED=false
CLO_SYNC_ENABLED=false

# SAMACHAR / SVACS (vessel detection change signal receiver)
SAMACHAR_ENDPOINT=http://localhost:8000
SAMACHAR_ENABLED=false

# Vedant read access (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
ECOSYSTEM_READ_API_KEY=generate-for-vedant-read-access
